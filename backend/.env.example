CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL is optional; the default is backend/pc_upgrade.db.
FRONTEND_URL=http://localhost:5173
# For HTTPS deployments: COOKIE_SECURE=true

# Password recovery: credentials from your mailbox or transactional email service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (usually 587), ssl (usually 465), none (local test SMTP only)
SMTP_SECURITY=starttls

# Optional normalized JSON feed, resolved relative to backend/.
OFFERS_FEED_FILE=
# Map source names ozon, avito, wb, yandex, dns to administrator-controlled
# HTTPS endpoints. Each receives query and category and returns {"offers": [...]}.
OFFERS_FEED_URLS={}
# Optional per-source bearer tokens, never sent to public marketplace pages.
OFFERS_FEED_TOKENS={}
OFFERS_LIVE_SEARCH=true

# Optional browser mode: install requirements-browser.txt first.
OFFERS_BROWSER_ENABLED=true
# Installed Edge on Windows; use an empty value for Playwright Chromium.
OFFERS_BROWSER_CHANNEL=msedge
# Optional existing dedicated local browser, e.g. http://127.0.0.1:9225.
# Leave empty to launch isolated headless browser contexts automatically.
OFFERS_BROWSER_CDP_URL=
OFFERS_BROWSER_TIMEOUT_MS=12000
OFFERS_BROWSER_PRODUCT_LIMIT=3
OFFERS_BROWSER_SEARCH_ENGINE=bing
