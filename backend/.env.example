CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL is optional; the default is backend/pc_upgrade.db.
FRONTEND_URL=http://localhost:5173
# For HTTPS deployments: COOKIE_SECURE=true

# Password recovery: credentials from your mailbox or transactional email service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (usually 587), ssl (usually 465), none (local test SMTP only)
SMTP_SECURITY=starttls

# Optional normalized JSON feed, resolved relative to backend/.
OFFERS_FEED_FILE=
# Map source names ozon, avito, wb, yandex, dns to administrator-controlled
# HTTPS endpoints. Each receives query and category and returns {"offers": [...]}.
OFFERS_FEED_URLS={}
# Optional per-source bearer tokens, never sent to public marketplace pages.
OFFERS_FEED_TOKENS={}
OFFERS_LIVE_SEARCH=true

# Optional browser mode: install requirements-browser.txt first.
OFFERS_BROWSER_ENABLED=false
# Installed Edge on Windows; use an empty value for Playwright Chromium.
OFFERS_BROWSER_CHANNEL=msedge
# Optional existing dedicated local browser, e.g. http://127.0.0.1:9225.
# Leave empty to launch isolated headless browser contexts automatically.
OFFERS_BROWSER_CDP_URL=
OFFERS_BROWSER_TIMEOUT_MS=12000
OFFERS_BROWSER_PRODUCT_LIMIT=3
OFFERS_BROWSER_SEARCH_ENGINE=bing

# Auth quotas. All windows are fixed and count admitted requests, not only failures.
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_PAIR_LIMIT=10
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_ACCOUNT_LIMIT=3
AUTH_PASSWORD_WINDOW_SECONDS=3600
AUTH_PASSWORD_IP_LIMIT=20
AUTH_PASSWORD_ACCOUNT_LIMIT=10
AUTH_RECOVERY_WINDOW_SECONDS=3600
AUTH_RECOVERY_IP_LIMIT=10
AUTH_RECOVERY_ACCOUNT_LIMIT=3
AUTH_RESET_IP_LIMIT=20
AUTH_CHALLENGE_BITS=18
AUTH_CHALLENGE_TTL_SECONDS=120
AUTH_IPV6_PREFIX=64
# Uvicorn proxy trust must be configured in the process environment, not this .env.
# Set FORWARDED_ALLOW_IPS only to verified proxy IPs/CIDRs; never use "*".
# Amvera's actual trusted proxy ranges must be confirmed before configuration.

# Chromium/CDP fail closed until verified OS-level egress isolation; this flag cannot bypass it.

# Optional external discovery. Never put the API key into frontend/VITE variables.
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_SEARCH_ENABLED=false
# Search tools are billed separately; leave disabled without operator approval.
OPENROUTER_ALLOW_PAID_WEB=false
OPENROUTER_DAILY_REQUESTS=20
OPENROUTER_DAILY_TOKENS=100000
OPENROUTER_DAILY_WEB_MICROUSD=0
OPENROUTER_MAX_OUTPUT_TOKENS=1200
OPENROUTER_TIMEOUT_SECONDS=20
# Download remains disabled without confirmed rights and network policy.
REGARD_DOWNLOAD_ENABLED=false
REGARD_PRICE_URL=
REGARD_SOURCE_UTC_OFFSET_MINUTES=180

# Catalog estimates: 24h fresh, up to 72h stale draft; never purchase verification.
CATALOG_PRELIMINARY_HOURS=72
