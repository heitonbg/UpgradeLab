DATABASE_URL=sqlite:///./upgradeLab-testing.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Без запросов к магазинам, сети Регарда, браузерных адаптеров и платного поиска.
OFFERS_LIVE_SEARCH=false
OFFERS_BROWSER_ENABLED=false
OPENROUTER_SEARCH_ENABLED=false
OPENROUTER_ALLOW_PAID_WEB=false
REGARD_DOWNLOAD_ENABLED=false
REGARD_BOOTSTRAP_ON_START=false

# SMTP и внешние ключи для локальной проверки не требуются.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
OPENROUTER_API_KEY=
