# Add these as Amvera application variables/secrets. Do not upload real credentials to Git.
FRONTEND_URL=https://upgrade.example.ru
CORS_ORIGINS=https://upgrade.example.ru
COOKIE_SECURE=true
# AMVERA automatically selects sqlite:////data/pc_upgrade.db as the default database.

# Configure these only if password recovery email should be active.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# The Amvera Docker image includes Chromium. Use the bundled browser, not system Edge.
OFFERS_BROWSER_ENABLED=true
OFFERS_BROWSER_CHANNEL=
OFFERS_HTTP_WORKERS=2

# Searches use public pages and the bundled browser. No external paid API keys.
