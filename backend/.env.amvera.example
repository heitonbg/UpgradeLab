# Add these as Amvera application variables/secrets. Do not upload real credentials to Git.
FRONTEND_URL=https://upgrade.example.ru
CORS_ORIGINS=https://upgrade.example.ru
COOKIE_SECURE=true
# AMVERA automatically selects sqlite:////data/pc_upgrade.db as the default database.

# Configure these only if password recovery email should be active.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# The Amvera Docker image includes Chromium. Use the bundled browser, not system Edge.
OFFERS_BROWSER_ENABLED=false
OFFERS_BROWSER_CHANNEL=
OFFERS_HTTP_WORKERS=2

# Searches use public pages and the bundled browser. No external paid API keys.

# Auth quotas. All windows are fixed and count admitted requests, not only failures.
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_PAIR_LIMIT=10
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_ACCOUNT_LIMIT=3
AUTH_PASSWORD_WINDOW_SECONDS=3600
AUTH_PASSWORD_IP_LIMIT=20
AUTH_PASSWORD_ACCOUNT_LIMIT=10
AUTH_RECOVERY_WINDOW_SECONDS=3600
AUTH_RECOVERY_IP_LIMIT=10
AUTH_RECOVERY_ACCOUNT_LIMIT=3
AUTH_RESET_IP_LIMIT=20
AUTH_CHALLENGE_BITS=18
AUTH_CHALLENGE_TTL_SECONDS=120
AUTH_IPV6_PREFIX=64
# Uvicorn proxy trust must be configured in the process environment, not this .env.
# Set FORWARDED_ALLOW_IPS only to verified proxy IPs/CIDRs; never use "*".
# Amvera's actual trusted proxy ranges must be confirmed before configuration.

# Chromium/CDP fail closed until verified OS-level egress isolation; this flag cannot bypass it.
