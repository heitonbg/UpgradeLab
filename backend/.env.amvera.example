# Add these as Amvera application variables/secrets. Do not upload real credentials to Git.
FRONTEND_URL=https://frontendupgradelab-iwrawww.waw0.amvera.tech
BACKEND_URL=https://backendupgradelab-iwrawww.waw0.amvera.tech
CORS_ORIGINS=https://frontendupgradelab-iwrawww.waw0.amvera.tech
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# AMVERA automatically selects sqlite:////data/pc_upgrade.db as the default database.

# Configure these only if password recovery email should be active.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# The Amvera Docker image includes Chromium. Use the bundled browser, not system Edge.
OFFERS_BROWSER_ENABLED=false
OFFERS_BROWSER_CHANNEL=
OFFERS_HTTP_WORKERS=2

# Searches use public pages and the bundled browser. No external paid API keys.

# Auth quotas. All windows are fixed and count admitted requests, not only failures.
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_PAIR_LIMIT=10
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_ACCOUNT_LIMIT=3
AUTH_PASSWORD_WINDOW_SECONDS=3600
AUTH_PASSWORD_IP_LIMIT=20
AUTH_PASSWORD_ACCOUNT_LIMIT=10
AUTH_RECOVERY_WINDOW_SECONDS=3600
AUTH_RECOVERY_IP_LIMIT=10
AUTH_RECOVERY_ACCOUNT_LIMIT=3
AUTH_RESET_IP_LIMIT=20
AUTH_CHALLENGE_BITS=18
AUTH_CHALLENGE_TTL_SECONDS=120
AUTH_IPV6_PREFIX=64
# Uvicorn proxy trust must be configured in the process environment, not this .env.
# Set FORWARDED_ALLOW_IPS only to verified proxy IPs/CIDRs; never use "*".
# Amvera's actual trusted proxy ranges must be confirmed before configuration.

# Chromium/CDP fail closed until verified OS-level egress isolation; this flag cannot bypass it.

# Optional external discovery. Never put the API key into frontend/VITE variables.
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_SEARCH_ENABLED=false
# Search tools are billed separately; leave disabled without operator approval.
OPENROUTER_ALLOW_PAID_WEB=false
OPENROUTER_DAILY_REQUESTS=20
OPENROUTER_DAILY_TOKENS=100000
OPENROUTER_DAILY_WEB_MICROUSD=0
OPENROUTER_MAX_OUTPUT_TOKENS=1200
OPENROUTER_TIMEOUT_SECONDS=20
# Download remains disabled without confirmed rights and network policy.
REGARD_DOWNLOAD_ENABLED=true
REGARD_PRICE_URL=https://www.regard.ru/api/site/pricelist
SOURCE_PERMISSIONS={"regard":{"automatic_network":true,"public_display":true,"basis":"UpgradeLab project owner confirmed authorized automatic download and public non-commercial display of official Regard XLSX on 2026-11-12","confirmed_by":"UpgradeLab project owner","confirmed_at":"2026-11-12T00:00:00Z"}}
REGARD_SOURCE_UTC_OFFSET_MINUTES=180

# Catalog estimates: 24h fresh, up to 72h stale draft; never purchase verification.
CATALOG_PRELIMINARY_HOURS=72
BENCHMARK_REVIEWER_EMAILS=

# One-time local XLSX bootstrap after Data files are uploaded.
REGARD_BOOTSTRAP_ON_START=true

# Daily import scheduler (worker is single-instance locked; download still requires all Regard permissions)
REGARD_DAILY_SYNC_ENABLED=true
BENCHMARK_IMPORT_ON_START=true
REGARD_DAILY_SYNC_INTERVAL_SECONDS=86400

# Steam requirements: backend only, no API key
STEAM_REQUIREMENTS_ENABLED=true
STEAM_WORKER_ENABLED=true
STEAM_REQUEST_INTERVAL_SECONDS=4
STEAM_REQUEST_TIMEOUT_SECONDS=10
STEAM_CACHE_DAYS=30
STEAM_NEGATIVE_CACHE_DAYS=7
STEAM_MAX_ATTEMPTS=3
STEAM_MAX_PENDING=500

# Queue polling only when worker is idle
STEAM_WORKER_IDLE_SECONDS=10
